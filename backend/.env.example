PLATFORM_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/platform
POSTGRES_ADMIN_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

QR_SIGNING_KEY=change-me-dev-only
JWT_SECRET_KEY=change-me-dev-only
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=720

# /platform/* routes (school enrollment, billing) are gated by a real
# PlatformStaffUser login — no env var needed. Bootstrap your first
# account with: python -m app.jobs.create_platform_staff --email you@... --name "You"

# Welfare-email + parent-invite delivery, via Postmark's HTTP API (not
# SMTP — see app/core/email.py; most PaaS hosts silently block outbound
# SMTP ports). Leave blank in dev — emails are logged instead of sent.
POSTMARK_SERVER_TOKEN=
EMAIL_FROM_ADDRESS=attendance@example.com

# Push notifications on scan. Leave blank in dev — pushes are logged
# instead of sent. Set to your Firebase service-account JSON (single line)
# to go live.
FIREBASE_CREDENTIALS_JSON=

# Paystack billing. Leave blank in dev — checkout-session creation returns a
# clear 501 instead of a fake URL. Fill in with your own Paystack account's
# test-mode secret key to try it out. Each checkout is a one-off transaction
# for a specific invoice's amount, not a Plan, so there's no plan-code
# setting. Webhooks are verified with PAYSTACK_SECRET_KEY itself
# (HMAC-SHA512) — there's no separate webhook secret like Stripe has.
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=https://example.com/billing/callback

PLATFORM_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/platform
POSTGRES_ADMIN_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

QR_SIGNING_KEY=change-me-dev-only
JWT_SECRET_KEY=change-me-dev-only
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=720

# Shared secret gating /platform/* routes (school enrollment, billing).
# Change before this goes anywhere near production.
PLATFORM_ADMIN_KEY=change-me-dev-only

# Welfare-email + parent-invite delivery. Leave blank in dev — emails are
# logged instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=attendance@example.com
SMTP_USE_TLS=true

# Push notifications on scan. Leave blank in dev — pushes are logged
# instead of sent. Set to your Firebase service-account JSON (single line)
# to go live.
FIREBASE_CREDENTIALS_JSON=

# Stripe billing. Leave blank in dev — checkout-session creation returns a
# clear 501 instead of a fake URL. Fill in with your own Stripe account's
# test-mode keys to try it out.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_SUCCESS_URL=https://example.com/billing/success
STRIPE_CANCEL_URL=https://example.com/billing/cancel
